<Window x:Class="TiendaRopaCano.Presentation.Views.Inventario.MovimientoInventarioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ajuste de Inventario" 
        Height="470" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Estilo TextBox Premium -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F4F6F8"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="#0B2447"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0B2447"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E3A8A"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Segmented RadioButton -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#F4F6F8" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="CheckIcon" Text="○ " Foreground="#4B5563" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B2447"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B2447"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="CheckIcon" Property="Text" Value="● "/>
                                <Setter TargetName="CheckIcon" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B2447"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" CornerRadius="15" BorderThickness="1" BorderBrush="#E5E7EB">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header con cerrar -->
            <Border Grid.Row="0" Background="#F4F6F8" CornerRadius="15,15,0,0" Padding="20,15">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconAjustes}" Fill="#1F2937" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Ajuste de Inventario" Foreground="#1F2937" FontSize="16" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding NombreProducto}" Foreground="#9DA0B1" FontSize="12" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" 
                            Foreground="#808080" FontSize="16" Cursor="Hand" Command="{Binding CancelarCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Width="24" Height="24">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25,20">
                    <!-- Tipo de Movimiento -->
                    <TextBlock Text="TIPO DE MOVIMIENTO" Foreground="#4B5563" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,8" FontFamily="Segoe UI"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <RadioButton Grid.Column="0" Content="Entrada de Stock" IsChecked="{Binding EsEntrada}"/>
                        <RadioButton Grid.Column="1" Content="Salida de Stock" IsChecked="{Binding EsSalida}"/>
                    </Grid>

                    <!-- Stock Actual (Info) -->
                    <TextBlock Text="STOCK ACTUAL EN TIENDA" Foreground="#4B5563" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,8" FontFamily="Segoe UI"/>
                    <Border Background="#F4F6F8" CornerRadius="8" Padding="15,12" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#E5E7EB">
                        <TextBlock Text="{Binding StockActual}" Foreground="#1F2937" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Cantidad -->
                    <TextBlock Text="CANTIDAD A AJUSTAR" Foreground="#4B5563" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,8" FontFamily="Segoe UI"/>
                    <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                    <!-- Motivo -->
                    <TextBlock Text="MOTIVO / REFERENCIA" Foreground="#4B5563" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,8" FontFamily="Segoe UI"/>
                    <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Border Grid.Row="2" Background="#F4F6F8" CornerRadius="0,0,15,15" Padding="25,15">
                <Grid>
                    <Button Content="Cancelar" 
                            Command="{Binding CancelarCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Left" Width="100" Height="38" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" BorderThickness="1" BorderBrush="#E5E7EB" CornerRadius="8">
                                    <TextBlock Text="Cancelar" Foreground="#4B5563" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding GuardarCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Right" Width="160" Height="38" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0B2447" Offset="0"/>
                                            <GradientStop Color="#1E3A8A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFloppy}" Fill="White" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Aplicar Ajuste" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>


