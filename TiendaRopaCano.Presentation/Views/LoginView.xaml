<Window x:Class="TiendaRopaCano.Presentation.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:TiendaRopaCano.Presentation.Helpers"
        mc:Ignorable="d"
        Title="Tienda de Ropa Cano — Iniciar Sesión"
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Estilo para TextBox moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="#0B2447"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0B2447"/>
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para PasswordBox moderno -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="#0B2447"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0B2447"/>
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contenedor principal flotante con sombra y esquinas redondeadas -->
    <Border CornerRadius="16" Background="#FFFFFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
        </Border.Effect>

        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= COLUMNA IZQUIERDA: DISEÑO BRANDING ================= -->
            <Border Grid.Column="0" CornerRadius="16,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B2447" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <!-- Elementos decorativos de fondo abstractos -->
                <Grid ClipToBounds="True">
                    <!-- Círculo difuminado decorativo 1 -->
                    <Ellipse Width="300" Height="300" Fill="#1D4ED8" Opacity="0.15" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0">
                        <Ellipse.Effect>
                            <BlurEffect Radius="40"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    
                    <!-- Círculo difuminado decorativo 2 -->
                    <Ellipse Width="250" Height="250" Fill="#1E40AF" Opacity="0.2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80">
                        <Ellipse.Effect>
                            <BlurEffect Radius="30"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Contenido del Branding -->
                    <StackPanel VerticalAlignment="Center" Margin="35,0">
                        <!-- Logotipo -->
                        <Border Width="70" Height="70" CornerRadius="35" Background="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                            </Border.Effect>
                            <TextBlock Text="👕" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Border>

                        <!-- Nombre de la marca -->
                        <TextBlock Text="TIENDA CANO" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Separador sutil -->
                        <Border Width="60" Height="2" Background="#93C5FD" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <!-- Texto descriptivo -->
                        <TextBlock Text="Controla tu stock, optimiza tus ventas y analiza el rendimiento de tu negocio de moda en tiempo real." 
                                   Foreground="#E0F2FE" FontSize="12.5" FontFamily="Segoe UI" LineHeight="20" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.9"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ================= COLUMNA DERECHA: FORMULARIO DE INGRESO ================= -->
            <Grid Grid.Column="1">
                <!-- Zona superior de control de la ventana (para arrastre y cierre) -->
                <Grid VerticalAlignment="Top" Height="45" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            Foreground="#9CA3AF"
                            BorderThickness="0"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Width="40" Height="40"
                            Margin="0,4,4,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="20">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Formulario -->
                <StackPanel VerticalAlignment="Center" Margin="50,45,50,30">
                    <!-- Títulos -->
                    <TextBlock Text="¡Bienvenido de nuevo!" Foreground="#111827" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                    <TextBlock Text="Por favor ingresa tus datos para acceder al sistema." Foreground="#6B7280" FontSize="13.5" FontFamily="Segoe UI" Margin="0,0,0,28"/>

                    <!-- Campo Usuario -->
                    <TextBlock Text="NOMBRE DE USUARIO" Foreground="#4B5563" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,6"/>
                    <TextBox x:Name="UsuarioTextBox"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="UsuarioTextBox_KeyDown"
                             Margin="0,0,0,18"/>

                    <!-- Campo Contraseña con botón de Ver/Ocultar -->
                    <TextBlock Text="CONTRASEÑA" Foreground="#4B5563" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI" Margin="2,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <PasswordBox x:Name="ContrasenaBox"
                                     helpers:PasswordHelper.Attach="True"
                                     helpers:PasswordHelper.Password="{Binding Contrasena, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="ContrasenaBox_KeyDown"
                                     Padding="12,10,40,10">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource ModernPasswordBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostrarContrasena}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MostrarContrasena}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        
                        <TextBox x:Name="ContrasenaReveladaBox"
                                 Text="{Binding Contrasena, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ContrasenaBox_KeyDown"
                                 Padding="12,10,40,10">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostrarContrasena}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MostrarContrasena}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Botón del Ojo -->
                        <ToggleButton x:Name="TogglePasswordBtn"
                                      IsChecked="{Binding MostrarContrasena, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Cursor="Hand"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Width="20" Height="20">
                                        <Path x:Name="EyeIcon"
                                              Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                              Fill="#9CA3AF" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="EyeIcon" Property="Fill" Value="#0B2447"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="EyeIcon" Property="Fill" Value="#9CA3AF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="EyeIcon" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <!-- Mensaje de Error -->
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="#EF4444"
                               FontSize="12"
                               FontWeight="Medium"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Left"
                               Margin="2,2,0,14"
                               TextWrapping="Wrap"
                               Visibility="{Binding MensajeError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Botón Ingresar -->
                    <Button Content="Iniciar Sesión"
                            Command="{Binding IngresarCommand}"
                            Height="46"
                            FontSize="14"
                            FontWeight="Bold"
                            FontFamily="Segoe UI"
                            Foreground="White"
                            Cursor="Hand"
                            BorderThickness="0"
                            Margin="0,6,0,16">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder" CornerRadius="8" Padding="0,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0B2447" Offset="0"/>
                                            <GradientStop Color="#1E3A8A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Indicador de carga -->
                    <ProgressBar IsIndeterminate="{Binding IsLoading}"
                                 Height="3"
                                 Background="Transparent"
                                 Foreground="#0B2447"
                                 BorderThickness="0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,0,0,12"/>
                    <!-- Link Registrarse (Solo si no hay usuarios registrados en el sistema) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"
                                Visibility="{Binding MostrarRegistroLink, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="¿No tienes una cuenta? " Foreground="#4B5563" FontSize="13" FontFamily="Segoe UI"/>
                        <TextBlock Text="Regístrate aquí"
                                   Foreground="#1E3A8A"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="Registrarse_Click">
                            <TextBlock.TextDecorations>
                                <TextDecoration Location="Underline"/>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Footer corporativo -->
                <TextBlock Text="© 2026 Tienda de Ropa Cano. Todos los derechos reservados." 
                           Foreground="#9CA3AF" FontSize="10.5" FontFamily="Segoe UI" 
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
            </Grid>
        </Grid>
    </Border>
</Window>
