<UserControl x:Class="TiendaRopaCano.Presentation.Views.Usuarios.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:TiendaRopaCano.Presentation.Helpers"
             Background="Transparent">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="DarkDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E5E7EB"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E9ECEF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Contenido solo para administrador -->
        <Grid Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVisibilityConverter}}" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Cabecera -->
                <RowDefinition Height="Auto"/> <!-- Estadísticas -->
                <RowDefinition Height="Auto"/> <!-- Toolbar -->
                <RowDefinition Height="Auto"/> <!-- Loading -->
                <RowDefinition Height="*"/>    <!-- Tabla -->
            </Grid.RowDefinitions>

            <!-- Cabecera de Usuarios -->
            <Border Grid.Row="0" Margin="0,0,0,20" Padding="20,15" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono circular degradado -->
                        <Border Width="46" Height="46" CornerRadius="12" Margin="0,0,15,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0B2447" Offset="0"/>
                                    <GradientStop Color="#1E3A8A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{StaticResource IconUsuarios}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="CONTROL DE USUARIOS" Foreground="#1F2937" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="Administra cuentas de empleados, gestiona credenciales de acceso y asigna roles en el sistema" Foreground="#4B5563" FontSize="11" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Usuarios Registrados: " Foreground="#4B5563" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding TotalUsuarios}" Foreground="#0B2447" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Resumen de Estadísticas Rediseñado -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Usuarios -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="15" Margin="0,0,10,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TOTAL USUARIOS" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding TotalUsuarios}" Foreground="#1F2937" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0B2447" Offset="0"/>
                                    <GradientStop Color="#1E3A8A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{StaticResource IconUsuarios}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Activos -->
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="15" Margin="10,0,10,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVOS" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding UsuariosActivos}" Foreground="#15803D" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{StaticResource IconActive}" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Inactivos -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="15" Margin="10,0,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="INACTIVOS" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding UsuariosInactivos}" Foreground="#F87171" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DC2626" Offset="0"/>
                                    <GradientStop Color="#B91C1C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{StaticResource IconInactive}" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="↻ Refrescar"
                            Command="{Binding CargarUsuariosCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#E2E8F0"
                            Margin="0,0,8,0"/>

                    <Button Command="{Binding ExportarUsuariosPdfCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#E2E8F0"
                            Margin="0,0,12,0" Width="130">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄 " VerticalAlignment="Center"/>
                            <TextBlock Text="Exportar PDF" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Border Background="#E5E7EB" CornerRadius="8" Width="250" Height="38">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#4B5563"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="#1F2937" 
                                     VerticalContentAlignment="Center" 
                                     Margin="5,0,10,0"
                                     CaretBrush="#0B2447"
                                     FontSize="13"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="＋ Agregar"
                            Command="{Binding AgregarUsuarioCommand}"
                            Style="{StaticResource ActionButton}"
                            Foreground="White"
                            Margin="0,0,8,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0B2447" Offset="0"/>
                                <GradientStop Color="#1E3A8A" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Content="✏️ Editar"
                            Command="{Binding EditarUsuarioCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#E2E8F0"
                            Margin="0,0,8,0"/>
                    <Button Content="🚫 Estado"
                            Command="{Binding CambiarEstadoCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#E2E8F0"
                            Margin="0,0,8,0"/>
                    <Button Content="🗑️ Eliminar"
                            Command="{Binding EliminarUsuarioCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#DC2626"
                            Foreground="White"/>
                </StackPanel>
            </Grid>

            <!-- Loading -->
            <ProgressBar Grid.Row="3"
                          IsIndeterminate="{Binding IsLoading}"
                          Height="3" Background="Transparent"
                          Foreground="#0B2447" BorderThickness="0"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="0,0,0,8"/>

            <!-- Tabla Usuarios -->
            <Border Grid.Row="4" CornerRadius="12"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB" BorderThickness="1"
                    Padding="10">
                <DataGrid Style="{StaticResource DarkDataGrid}"
                          ItemsSource="{Binding Usuarios}"
                          SelectedItem="{Binding UsuarioSeleccionado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre Completo"
                                            Binding="{Binding NombreCompleto}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Usuario"
                                            Binding="{Binding NombreUsuario}"
                                            Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5,0"/>
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Rol"
                                            Binding="{Binding Rol.Nombre}"
                                            Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Estado" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Activo"/>
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Text" Value="Inactivo"/>
                                                            <Setter Property="Foreground" Value="#F87171"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Mensaje acceso denegado -->
        <Border Grid.RowSpan="5" Background="#E8FFFFFF"
                Visibility="{Binding EsAdministrador,
                    Converter={StaticResource BoolToVisibilityConverter},
                    ConverterParameter=Invert}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🔒" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Acceso Restringido" FontSize="24" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                <TextBlock Text="Solo los administradores pueden gestionar usuarios." 
                           Foreground="#4B5563" Margin="0,10,0,0" HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


