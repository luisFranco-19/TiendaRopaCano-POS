<UserControl x:Class="TiendaRopaCano.Presentation.Views.Reportes.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Colores del tema oscuro -->
        <SolidColorBrush x:Key="BackgroundColor" Color="#1A1D2E"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#1E2235"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2D3154"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#4B5563"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#DC2626"/>

        <!-- Convertidor Bool a Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Estilo ActionButton -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo DarkDataGrid -->
        <Style x:Key="DarkDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#E5E7EB"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="#4B5563"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo DatePicker oscuro -->
        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Root"
                                Background="#E5E7EB"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox Grid.Column="0"
                                                  x:Name="PART_TextBox"
                                                  Foreground="#111827"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="10,0,4,0"
                                                  VerticalAlignment="Center"
                                                  FontFamily="Segoe UI"
                                                  FontSize="12"
                                                  CaretBrush="#0B2447"
                                                  SelectionBrush="#0B2447"/>
                                <Button Grid.Column="1"
                                        x:Name="PART_Button"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Width="32"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="📅"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="#0B2447"/>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       PlacementTarget="{Binding ElementName=Root}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0B2447"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Cabecera -->
            <RowDefinition Height="Auto"/> <!-- Filtros -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="300"/>  <!-- Charts / Alerts -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Cabecera de Reportes -->
        <Border Grid.Row="0" Margin="0,0,0,20" Padding="20,15" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="12" Margin="0,0,15,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B2447" Offset="0"/>
                                <GradientStop Color="#1E3A8A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconReportes}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="REPORTES Y ESTADÍSTICAS" Foreground="#1F2937" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"/>
                        <TextBlock Text="Analiza las ventas, monitorea utilidades y exporta informes del rendimiento de tu negocio" Foreground="#4B5563" FontSize="11" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filtros y Controles -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="15" Margin="0,0,0,16" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#4B5563" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"/>
                <DatePicker SelectedDate="{Binding FechaDesde}" Style="{StaticResource DarkDatePicker}" Margin="0,0,20,0"/>
                
                <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#4B5563" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"/>
                <DatePicker SelectedDate="{Binding FechaHasta}" Style="{StaticResource DarkDatePicker}" Margin="0,0,20,0"/>
                
                <Button Content="↻ Actualizar" Command="{Binding RefrescarCommand}" Style="{StaticResource ActionButton}" Background="#E2E8F0" Foreground="#1F2937" Width="110" Margin="0,0,10,0"/>
                
                <Rectangle Width="1" Fill="#E5E7EB" Margin="10,5" Height="25"/>

                <Button Command="{Binding ExportarPdfCommand}" Style="{StaticResource ActionButton}" Background="#DC2626" Width="130" Margin="10,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄 " VerticalAlignment="Center"/>
                        <TextBlock Text="Exportar PDF" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExportarCsvCommand}" Style="{StaticResource ActionButton}" Background="#059669" Width="130" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 " VerticalAlignment="Center"/>
                        <TextBlock Text="Exportar CSV" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExportarStockBajoPdfCommand}" Style="{StaticResource ActionButton}" Background="#E2E8F0" Foreground="#1F2937" Width="150">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📉 " VerticalAlignment="Center"/>
                        <TextBlock Text="Stock Bajo (PDF)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                             Width="30" Height="30" Margin="20,0,0,0" />
            </StackPanel>
        </Border>

        <!-- KPI Cards Rediseñadas -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ventas Totales -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,8,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="VENTAS TOTALES" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding VentasTotales, StringFormat={}{0:C}}" Foreground="#1F2937" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B2447" Offset="0"/>
                                <GradientStop Color="#1E3A8A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconDinero}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Utilidad Real -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="8,0,8,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="UTILIDAD ESTIMADA" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding UtilidadTotal, StringFormat={}{0:C}}" Foreground="#15803D" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconUtilidad}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Cantidad de Ventas -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="8,0,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TRANSACCIONES" Foreground="#4B5563" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding CantidadVentas}" Foreground="#1F2937" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconFactura}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Charts and Alerts -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Gráfico de Tendencias -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,8,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tendencia de Ventas Diarias" Foreground="#1F2937" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" FontFamily="Segoe UI"/>
                    <lvc:CartesianChart Grid.Row="1" 
                                        Series="{Binding SeriesVentas}" 
                                        XAxes="{Binding XAxes}" 
                                        YAxes="{Binding YAxes}"
                                        Background="Transparent"/>
                </Grid>
            </Border>

            <!-- Alertas de Stock Bajo -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="8,0,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="⚠️" Foreground="#DC2626" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Alertas de Stock Bajo" Foreground="#1F2937" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding ProductosBajoStock}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="13"/>
                                            <TextBlock Text="{Binding Categoria.Nombre, StringFormat='Cat: {0}'}" FontSize="11" Foreground="#4B5563" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Stock, StringFormat='Stock: {0}'}" FontWeight="Bold" Foreground="#F87171" FontSize="11" FontFamily="Segoe UI"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Tabla de Datos -->
        <Border Grid.Row="4" Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Detalle de Ventas por Día" Foreground="#1F2937" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" FontFamily="Segoe UI"/>
                <DataGrid Grid.Row="1" Style="{DynamicResource DarkDataGrid}" 
                          ItemsSource="{Binding VentasDiarias}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cant. Ventas" Binding="{Binding CantidadVentas}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5,0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total Vendido" Binding="{Binding TotalVentas, StringFormat={}{0:C}}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1F2937"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Utilidad" Binding="{Binding Utilidad, StringFormat={}{0:C}}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#15803D"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>


