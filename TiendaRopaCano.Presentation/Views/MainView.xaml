<Window x:Class="TiendaRopaCano.Presentation.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:TiendaRopaCano.Presentation.Helpers"
        mc:Ignorable="d"
        Title="Tienda de Ropa Cano — Sistema de Gestión"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowState="Maximized">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Iconos Geometría Vectorial -->
        <Geometry x:Key="IconLogo">M18.8,3H15.2C15.1,4 14.2,4.8 13,4.8C11.8,4.8 10.9,4 10.8,3H7.2L3,5.5L4.8,9.5L7,8.6V21H17V8.6L19.2,9.5L21,5.5L18.8,3Z</Geometry>
        <Geometry x:Key="IconVentas">M7,18A2,2 0 0,0 5,20A2,2 0 0,0 7,22A2,2 0 0,0 9,20A2,2 0 0,0 7,18M1,2V4H3L6.6,11.59L5.25,14.04C5.1,14.3 5,14.65 5,15A2,2 0 0,0 7,17H19V15H7.42A0.25,0.25 0 0,1 7.17,14.75L7.2,14.63L8.1,13H15.55C16.3,13 16.96,12.59 17.3,11.97L21.16,4.96C21.25,4.8 21.3,4.6 21.3,4.4A1,1 0 0,0 20.3,3.4H5.21L4.27,1.4H1V2M17,18A2,2 0 0,0 15,20A2,2 0 0,0 17,22A2,2 0 0,0 19,20A2,2 0 0,0 17,18Z</Geometry>
        <Geometry x:Key="IconInventario">M12,2L2,7L12,12L22,7L12,2M2,9V17L12,22V14L2,9M22,9L12,14V22L22,17V9Z</Geometry>
        <Geometry x:Key="IconReportes">M19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M9,17H7V10H9V17M13,17H11V7H13V17M17,17H15V12H17V17Z</Geometry>
        <Geometry x:Key="IconCategorias">M5.5,5A1.5,1.5 0 0,0 4,6.5A1.5,1.5 0 0,0 5.5,8A1.5,1.5 0 0,0 7,6.5A1.5,1.5 0 0,0 5.5,5M21.41,11.58L12.41,2.58C12.05,2.22 11.55,2 11,2H4C2.89,2 2,2.89 2,4V11C2,11.55 2.22,12.05 2.59,12.42L11.59,21.42C11.95,21.78 12.45,22 13,22C13.55,22 14.05,21.78 14.41,21.41L21.41,14.41C21.78,14.05 22,13.55 22,13C22,12.45 21.78,11.95 21.41,11.58Z</Geometry>
        <Geometry x:Key="IconUsuarios">M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z</Geometry>
        <Geometry x:Key="IconCerrarSesion">M14.08,15.59L16.67,13H7V11H16.67L14.08,8.41L15.5,7L20.5,12L15.5,17L14.08,15.59M19,3A2,2 0 0,1 21,5V9.67H19V5H5V19H19V14.33H21V19A2,2 0 0,1 19,21H5C3.89,21 3,20.1 3,19V5C3,3.89 3.89,3 5,3H19Z</Geometry>

        <!-- Estilo botón menú lateral -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,2"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Indicador vertical activo -->
                                <Border x:Name="Indicator" Grid.Column="0" Width="3" Height="16" Background="#0B2447" CornerRadius="1.5" Margin="-8,0,8,0" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#0B2447"/>
                            </Trigger>
                            <Trigger Property="Foreground" Value="#0B2447">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo botón menú activo -->
        <Style x:Key="MenuButtonActive" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#0B2447"/>
        </Style>

        <!-- Estilo botones de ventana (Minimizar, Maximizar) -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#0B2447"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo botón cerrar ventana -->
        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#F4F6F8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====== SIDEBAR ====== -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo / Marca -->
                    <StackPanel Grid.Row="0" Margin="24,24,24,20">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38"
                                    CornerRadius="10"
                                    Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0B2447" Offset="0"/>
                                        <GradientStop Color="#1E3A8A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="{StaticResource IconLogo}"
                                      Fill="White"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TIENDA CANO"
                                           Foreground="#0B2447"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="Sistema de Gestión"
                                           Foreground="#6B7280"
                                           FontSize="10"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Separador -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#E5E7EB"
                            Margin="20,0,20,16"/>

                    <!-- Menú de Navegación -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,0">

                        <TextBlock Text="MENÚ PRINCIPAL"
                                   Foreground="#6B7280"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   Margin="28,0,0,10"/>

                        <!-- Botón Ventas -->
                        <Button Command="{Binding NavegarVentasCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MenuVentasActivo}" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Setter Property="Foreground" Value="#0B2447"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconVentas}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Ventas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Inventario -->
                        <Button Command="{Binding NavegarInventarioCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MenuInventarioActivo}" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Setter Property="Foreground" Value="#0B2447"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInventario}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Inventario" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Reportes (solo Admin) -->
                        <Button Command="{Binding NavegarReportesCommand}"
                                Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MenuReportesActivo}" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Setter Property="Foreground" Value="#0B2447"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReportes}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Reportes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Categorías (solo Admin) -->
                        <Button Command="{Binding NavegarCategoriasCommand}"
                                Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MenuCategoriasActivo}" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Setter Property="Foreground" Value="#0B2447"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCategorias}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Categorías" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Usuarios (solo Admin) -->
                        <Button Command="{Binding NavegarUsuariosCommand}"
                                Visibility="{Binding EsAdministrador, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MenuUsuariosActivo}" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Setter Property="Foreground" Value="#0B2447"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUsuarios}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Usuarios" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Perfil de usuario abajo -->
                    <Border Grid.Row="3"
                            Background="#F8F9FA"
                            CornerRadius="0,0,0,12"
                            Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0B2447" Offset="0"/>
                                        <GradientStop Color="#1E3A8A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="{StaticResource IconUsuarios}"
                                      Fill="White"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <!-- Info usuario -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NombreUsuario}"
                                           Foreground="#111827"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding RolUsuario}"
                                           Foreground="#6B7280"
                                           FontSize="10"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>

                            <!-- Botón cerrar sesión -->
                            <Button Grid.Column="2"
                                    Command="{Binding CerrarSesionCommand}"
                                    ToolTip="Cerrar Sesión"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Width="32" Height="32"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <Path Data="{StaticResource IconCerrarSesion}"
                                                              Fill="{TemplateBinding Foreground}"
                                                              Width="16" Height="16"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ====== CONTENIDO PRINCIPAL ====== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra superior -->
                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        Padding="24,14"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="{Binding TituloSeccion}"
                                   Foreground="#0B2447"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <!-- Minimizar -->
                            <Button Content="—"
                                    Click="MinimizeButton_Click"
                                    Style="{StaticResource WindowControlBtn}"/>
                            <!-- Maximizar -->
                            <Button Content="☐"
                                    Click="MaximizeButton_Click"
                                    Style="{StaticResource WindowControlBtn}"/>
                            <!-- Cerrar -->
                            <Button Content="✕"
                                    Click="CloseButton_Click"
                                    Style="{StaticResource WindowCloseBtn}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Área de contenido dinámico -->
                <Border Grid.Row="1"
                        Background="#F4F6F8"
                        CornerRadius="0,0,12,0"
                        Padding="24,16">
                    <ContentControl Content="{Binding VistaActual}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>



