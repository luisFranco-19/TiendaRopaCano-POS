<Window x:Class="TiendaRopaCano.Presentation.Views.Ventas.NuevaVentaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:TiendaRopaCano.Presentation.Helpers"
        mc:Ignorable="d"
        Title="Nueva Venta" Height="720" Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Estilo Botón Moderno -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón Ícono -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón Cantidad (Pequeño y redondo) -->
        <Style x:Key="QtyButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B2447"/>
                                <Setter Property="Foreground" Value="#0B2447"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón Eliminar Carrito -->
        <Style x:Key="DeleteCartButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D1A1A"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón Agregar Producto Catálogo -->
        <Style x:Key="AddProductButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderBrush="#E5E7EB" BorderThickness="1.5" Background="#F4F6F8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado / Barra de Título -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="12" Margin="0,0,15,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B2447" Offset="0"/>
                                <GradientStop Color="#1E3A8A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconVentas}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PUNTO DE VENTA" Foreground="#1F2937" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                        <TextBlock Text="Tienda Cano Rivas — Módulo de Facturación" Foreground="#4B5563" FontSize="11" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
                
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource IconButton}" Foreground="#4B5563" FontSize="16"
                        Command="{Binding CancelarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>

            <!-- Contenido Principal -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/> <!-- Catálogo de Productos -->
                    <ColumnDefinition Width="450"/> <!-- Carrito de compras -->
                </Grid.ColumnDefinitions>

                <!-- Panel Izquierdo: Catálogo -->
                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="10" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Foreground="#0B2447" VerticalAlignment="Center" Margin="15,0,10,0" FontSize="14"/>
                            <TextBox Grid.Column="1" Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Foreground="#1F2937"
                                     Padding="0,12" VerticalContentAlignment="Center" FontSize="14"
                                     CaretBrush="#0B2447"
                                     KeyDown="BuscarTextBox_KeyDown">
                                <TextBox.Resources>
                                    <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.4" Stretch="None" AlignmentX="Left">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="Buscar producto por nombre o categoría..." Foreground="#4B5563" FontSize="14" FontFamily="Segoe UI"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </TextBox.Resources>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Catálogo de Productos y Estado Vacío -->
                    <Grid Grid.Row="1">
                        <!-- Mensaje de Estado Vacío -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Catálogo Vacío o sin Coincidencias" Foreground="#1F2937" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                            <TextBlock Text="Asegúrate de tener productos registrados con stock disponible mayor a 0 en el Inventario para que aparezcan aquí." Foreground="#4B5563" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="350" FontFamily="Segoe UI"/>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProductosFiltrados.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>

                        <Border CornerRadius="12" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProductosFiltrados.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                            <ItemsControl ItemsSource="{Binding ProductosFiltrados}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="220" Margin="6" CornerRadius="12" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#0B2447"/>
                                                            <Setter Property="Background" Value="#E9ECEF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Margin="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Fila 0: Badges (Categoría y Stock) -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Categoría Badge -->
                                                    <Border Grid.Column="0" Background="#E0E7FF" CornerRadius="6" HorizontalAlignment="Left" Padding="8,3">
                                                        <TextBlock Text="{Binding Categoria.Nombre}" Foreground="#1E3A8A" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                    
                                                    <!-- Stock Badge -->
                                                    <Border Grid.Column="1" Background="#F4F6F8" CornerRadius="6" HorizontalAlignment="Right" Padding="6,2" BorderThickness="1" BorderBrush="#E5E7EB">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Stock: " Foreground="#4B5563" FontSize="9"/>
                                                            <TextBlock Text="{Binding Stock}" Foreground="#1F2937" FontSize="9" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Fila 1: Nombre del Producto -->
                                                <TextBlock Grid.Row="1" Text="{Binding Nombre}" Foreground="#1F2937" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" VerticalAlignment="Top"/>
                                                
                                                <!-- Fila 2: Separador visual sutil -->
                                                <Border Grid.Row="2" Height="1" Background="#E5E7EB" Margin="0,5"/>

                                                <!-- Fila 3: Precio e ícono agregar -->
                                                <Grid Grid.Row="3">
                                                    <TextBlock Text="{Binding Precio, StringFormat=C2}" Foreground="#0B2447" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    
                                                    <Button Content="＋" HorizontalAlignment="Right"
                                                            Style="{StaticResource AddProductButton}"
                                                            Command="{Binding DataContext.AgregarAlCarritoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#0B2447" Offset="0"/>
                                                                <GradientStop Color="#1E3A8A" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Button.Background>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    </Grid>
                </Grid>

                <!-- Panel Derecho: Carrito -->
                <Border Grid.Column="1" CornerRadius="12" Background="#F4F6F8" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera Carrito con Contador -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0B2447" Offset="0"/>
                                        <GradientStop Color="#1E3A8A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="{StaticResource IconVentas}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CARRITO DE COMPRAS" Foreground="#4B5563" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <Border Background="#E5E7EB" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Carrito.Count}" Foreground="#0B2447" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Tabla Carrito (Con anchos fijos para evitar solapamientos) -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Carrito}" AutoGenerateColumns="False" 
                                  Background="Transparent" BorderThickness="0" Foreground="#1F2937"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="55"
                                  IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" 
                                  CanUserDeleteRows="False" CanUserResizeColumns="False" CanUserReorderColumns="False">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="0,0,0,10"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- Columna Producto -->
                                <DataGridTemplateColumn Header="Producto" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="5,0">
                                                <TextBlock Text="{Binding Producto.Nombre}" Foreground="#1F2937" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PrecioUnitario, StringFormat=C2}" Foreground="#4B5563" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Columna Cantidad (Pequeños botones modernos redondeados) -->
                                <DataGridTemplateColumn Header="Cant" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="-" Style="{StaticResource QtyButton}"
                                                        Command="{Binding DataContext.DecrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Cantidad}" Foreground="#1F2937" VerticalAlignment="Center" Margin="8,0" MinWidth="24" TextAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                                <Button Content="+" Style="{StaticResource QtyButton}"
                                                        Command="{Binding DataContext.IncrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Columna Total (Alineado a la derecha, ancho fijo) -->
                                <DataGridTextColumn Header="Total" Binding="{Binding Subtotal, StringFormat=C2}" Width="90" FontWeight="Bold" Foreground="#0B2447">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,10,0"/>
                                            <Setter Property="FontSize" Value="13"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <!-- Columna Eliminar -->
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️" Style="{StaticResource DeleteCartButton}"
                                                    Command="{Binding DataContext.QuitarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Totales y Botón Cobrar Rediseñados -->
                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            <!-- Card de Resumen de Pago -->
                            <Border Background="#F4F6F8" CornerRadius="10" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,15">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL A PAGAR" Foreground="#4B5563" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Carrito.Count}" Foreground="#0B2447" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                            <TextBlock Text=" artículos" Foreground="#4B5563" FontSize="12" FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Total, StringFormat=C2}" Foreground="#15803D" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                </Grid>
                            </Border>

                            <Button Content="PROCESAR COBRO" Margin="0" Height="48" FontSize="14" FontWeight="Bold"
                                    Command="{Binding FinalizarVentaCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0B2447" Offset="0"/>
                                                    <GradientStop Color="#1E3A8A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>


